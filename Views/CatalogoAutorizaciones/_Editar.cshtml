@model HelpDesk.Models.ViewModels.CatAutorizacionViewModel  

@{  
   ViewData["Title"] = "Editar Autorización";  
}  

<div class="modal-header">  
   <h4 class="modal-title">Editar Autorización</h4>  
</div>  
<div class="modal-body">  
   <div class="row">  
       <div class="col-md-12">  
           <form asp-action="Editar" class="row">  
               <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdAutorizacion" />"
               <div class="form-group col-sm-6">  
                   <label asp-for="IdArea" class="control-label">Área</label>  
                   <select asp-for="IdArea" class="form-control" asp-items="@(new SelectList(Model.CatalogoAreas, "IdArea", "Nombre"))" required>  
                   </select>  
                   <span asp-validation-for="IdArea" class="text-danger"></span>  
               </div>  

               <div class="form-group col-sm-6">  
                   <label asp-for="IdModuloClasificacion" class="control-label">Módulo Clasificación</label>  
                   <select asp-for="IdModuloClasificacion" class="form-control" asp-items="@(new SelectList(Model.CatalogoModulosClasificaciones, "IdModuloClasificacion", "Nombre"))" required>  
                   </select>  
                   <span asp-validation-for="IdModuloClasificacion" class="text-danger"></span>  
               </div>  

               <div class="form-group col-sm-12">  
                   <label asp-for="Requisitos" class="control-label"></label>  
                   <textarea asp-for="Requisitos" class="form-control" rows="4"></textarea>  
                   <span asp-validation-for="Requisitos" class="text-danger"></span>  
               </div>
                <div class="form-group col-sm-6">
                    <label asp-for="IdAreasAutorizan" class="control-label">Áreas qué autorizan</label>
                    <select asp-for="IdAreasAutorizan" class="form-control" asp-items="@(new SelectList(Model.CatalogoAreas, "IdArea", "Nombre"))" required>
                    </select>
                    <span asp-validation-for="IdAreasAutorizan" class="text-danger"></span>
                </div>
                <div class="form-group mt-4">  
                   <input type="submit" value="Guardar" class="btn btn-primary" />  
               </div>  
           </form>  
       </div>  
   </div>  
</div>  
<div class="modal-footer">  
   <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>  
</div>  
<script>

    new TomSelect('select[name="IdAreasAutorizan"]', {
        plugins: ['remove_button'],
        maxItems: null,
        create: false,
        persist: false,
        allowEmptyOption: true,
    });

</script>
@section Scripts {  
   @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }  
}
