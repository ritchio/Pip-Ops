@model List<HelpDesk.Models.ViewModels.CatAutorizacionViewModel>
<div class="row">
    <div class="col-8 d-flex justify-content-start">
        <i class="ti ti-sort-ascending-shapes mr-3" style="font-size:3em"></i>
        <div>
            <h2 class="page-title">Catálogo de Autorizaciones</h2>
            <div class="page-pretitle">Gestión de autorizaciones para las clasificaciones</div>
        </div>
    </div>
    <div class="col-4 d-flex justify-content-end">
        <button class="btn btn-primary" id="btnCrearAutorizacion" onclick="muestraCrearAutorizacion()">
            <i class="ti ti-circle-plus"></i> Autorización
        </button>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">

        <div class="card">
            <div class="card-header">Catálogo de autorizaciones</div>
            <div class="card-body">
                <table class="display table-responsive table-striped" style="width:100%" id="tablaAutorizaciones">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Área</th>
                            <th>Módulo / Clasificación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach(var item in Model)
                            {
                                <tr>
                                    <td>@item.IdAutorizacion</td>
                                    <td>@item.NombreAreaPertenece</td>
                                    <td>@item.NombreModuloClasificacion</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite editar la información de la autorización" onclick="muestraEditarAutorizacion(@item.IdAutorizacion)">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    $(function(){
     $("#tablaAutorizaciones").DataTable({
          language: lenguajeTablaGenerica
      });
    });


</script>
<script src="~/js/CatalogoAutorizaciones/index.js"></script>