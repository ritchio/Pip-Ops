@{
    Layout = "~/Views/Shared/_LayoutLimpio.cshtml";
    ViewData["Title"] = "Reiniciar Contraseña";
}


<div class="card col-sm-6 m-auto">
    <div class="card-header">Reiniciar contraseña </div>
    <div class="card-body">
        <h5>Capture el correo registrado para poder enviar la información necesaria.</h5>
        <form method="post" asp-action="ReiniciarContrasenia">
            <div class="mb-3">
                <label for="correo" class="form-label">Correo electrónico</label>
                <input name="correo" class="form-control" type="email" required/>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Enviar contraseña</button>
            </div>
        </form>

    </div>
</div>