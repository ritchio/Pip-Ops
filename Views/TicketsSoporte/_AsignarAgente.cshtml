@using HelpDesk.Models.ViewModels
@model List<CatUsuarioViewModel>

<div class="modal-header">  
    <h2>Asignar ticket a agente de soporte</h2>
</div>  
<div class="modal-body">
    <div class="form-group">
        <input type="hidden" id="idTicketAsignar" value="@ViewData["IdTicket"]"/>
        <label >Seleccione el agente</label>
        <select class="form-control" id="idUsuarioAsignar" asp-items="@(new SelectList(Model,"Id","NombreCompleto"))"></select>
       <div class="mt-4">
            <button class="btn btn-primary" onclick="asignarTicket($('#idTicketAsignar').val(),$('#idUsuarioAsignar').val())">Asignar Agente</button>
            <button class="btn btn-primary" onclick="asignarTicket($('#idTicketAsignar').val(),'auto')">Tomar el ticket</button>
       </div>
    </div>
</div>

    

