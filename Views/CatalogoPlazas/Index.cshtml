@using HelpDesk.Models.ViewModels
@model HelpDesk.Models.ViewModels.CatPlazasAreasViewModel

@{
    ViewData["Title"] = "Plazas / Áreas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-8 d-flex justify-content-start">
        <i class="ti ti-building mr-3" style="font-size:3em"></i>
        <div>
            <h2 class="page-title">Plazas / Áreas</h2>
            <div class="page-pretitle">Creación y gestión de plazas y áreas</div>
        </div>
    </div>
    <div class="col-4 justify-content-end d-flex">
        <button onclick="nuevoRegistro()" class="btn btn-primary">Nueva plaza / área</button>
    </div>
</div>
<div class="col-lg-6">
    <div class="card">
        <div class="card-header">
           <h4>Plazas</h4>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>
                            @Html.DisplayNameFor(model => model.Plazas.First().Nombre)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Plazas.First().Estado)
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var item in Model.Plazas) {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdPlaza)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </td>
                        <td id="plazaEstado_@item.IdPlaza">
                            @Html.DisplayFor(modelItem => item.Estado)
                        </td>
                        <td>
                                <button id="botonEstadoPlaza_@item.IdPlaza" type="button" onclick="desactivarPlaza(@item.IdPlaza)" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva la plaza">
                                    <i class="ti ti-circle-@(item.Activo.HasValue ? (item.Activo.Value ? "x" : "check") : "x")"></i>
                                </button>
                                <button type="button" onclick="obtenerPlazaPorId(@item.IdPlaza)" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite la edición de la plaza"><i class="ti ti-edit"></i></button>
                        </td>
                    </tr>
            }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="col-lg-6">
    <div class="card">
        <div class="card-header">
            <h4>Áreas</h4>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            #
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Areas.First().Nombre)
                        </th>
                        <th>Pertenece a</th>
                        <th>
                            @Html.DisplayNameFor(model => model.Areas.First().Estado)
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Areas)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.IdArea)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nombre)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NombrePlaza)
                            </td>
                            <td id="areaEstado_@item.IdArea">
                                @Html.DisplayFor(modelItem => item.Estado)
                            </td>
                            <td>
                                <button id="botonEstadoArea_@item.IdArea" type="button" onclick="desactivarArea(@item.IdArea)" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva el área">
                                    <i class="ti ti-circle-@(item.Activo.HasValue ? (item.Activo.Value ? "x" : "check") : "x")"></i>
                                </button>
                                <button type="button" onclick="obtenerAreaPorId(@item.IdArea)" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite la edicion del área"><i class="ti ti-edit"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="~/js/CatalogoPlazas/index.js"></script>