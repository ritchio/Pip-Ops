@using HelpDesk.Models.ViewModels
@model IEnumerable<AspNetUsersViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row mb-4">
    <div class="col-8 d-flex justify-content-start">
        <i class="ti ti-users" style="font-size:3em"></i>
        <div>
            <h2 class="page-title">Usuarios</h2>
            <div class="page-pretitle">Creación de usuarios, administración, y asignación de roles</div>
        </div>
    </div>
    <div class="col-4 justify-content-end d-flex">
        <button onclick="nuevoRegistro()" class="btn btn-primary"><i class="ti ti-circle-plus mr-2"></i>Nuevo usuario</button>
    </div>
</div>


    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs nav-fill" data-bs-toggle="tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a href="#todosUsuarios" class="nav-link active" data-bs-toggle="tab" aria-selected="true" role="tab">Todos los usuarios</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a href="#administrador" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Administrador</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a href="#soporte" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Soporte</a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a href="#usuario" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Usuario</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane active show" id="todosUsuarios" role="tabpanel">
                        <div class="display w-100">
                            <table class="table table-striped dt-responsive" id="tablaTodosUsuarios">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.NombreCompleto)
                                        </th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.CorreoElectronico)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.RolNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.PlazaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AreaNombre)
                                        </th>
                                        <th class="colapsable">
                                            @Html.DisplayNameFor(model => model.FechaInactivacion)
                                        </th>
                                        <th>
                                            Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.RolNombre)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td><td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>
                                           
                                            <td class="colapsable">
                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>
                                            
                                            
                                            <td>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-circle-x"></i></button>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-circle-key"></i></button>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-edit"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="administrador" role="tabpanel">
                        <div class="display w-100">
                            <table class="table table-striped table-responsive" id="tablaAdministrador">
                                <thead>
                                    <tr>
                                        <th>#</th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.NombreCompleto)
                                        </th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.CorreoElectronico)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.RolNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.PlazaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AreaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.FechaInactivacion)
                                        </th>
                                        <th>
                                            Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Administrador" || u.RolNombre == "Administrador Supervisor").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                            <td>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-circle-x"></i></button>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-circle-key"></i></button>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-edit"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="soporte" role="tabpanel">
                        <div class="display w-100">
                            <table class="table table-striped table-responsive" id="tablaSoporte">
                                <thead>
                                    <tr>
                                    <th>#</th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.NombreCompleto)
                                        </th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.CorreoElectronico)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.RolNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.PlazaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AreaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.FechaInactivacion)
                                        </th>
                                        <th>
                                            Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Soporte").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                            <td>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-circle-x"></i></button>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-circle-key"></i></button>
                                            <button type="button" class="btn btn-primary"><i class="ti ti-edit"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="usuario" role="tabpanel">
                        <div class="display w-100">
                            <table class="table table-striped table-responsive" id="tablaUsuario">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.NombreCompleto)
                                        </th>

                                        <th>
                                            @Html.DisplayNameFor(model => model.CorreoElectronico)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.RolNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.PlazaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AreaNombre)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.FechaInactivacion)
                                        </th>
                                        <th>
                                            Acciones
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Usuario").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                            <td>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-circle-x"></i></button>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-circle-key"></i></button>
                                                <button type="button" class="btn btn-primary"><i class="ti ti-edit"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



<script>
    $(document).ready(function() {
        $('#tablaTodosUsuarios').DataTable({
            responsive:{
                details:{
                    type:"column",
                    targets: -2 
                }
            },
            columnDefs: [
        {
            className: 'dtr-control',
            orderable: false,
            targets: -2
        },
            language: lenguajeTablaGenerica
        });
        $('#tablaAdministrador').DataTable({
            language: lenguajeTablaGenerica
        });
        $('#tablaSoporte').DataTable({
            language: lenguajeTablaGenerica
        });
        $('#tablaUsuario').DataTable({
            language: lenguajeTablaGenerica
        });
    } );</script>