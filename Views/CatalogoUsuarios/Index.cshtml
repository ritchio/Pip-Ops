@using HelpDesk.Models.ViewModels
@model IEnumerable<AspNetUsersViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreCompleto)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.CorreoElectronico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Activo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaActivacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaInactivacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdPlaza)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlazaNombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
           
            <td>
                @Html.DisplayFor(modelItem => item.NombreCompleto)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.CorreoElectronico)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Activo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaActivacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaInactivacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdPlaza)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlazaNombre)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
