@using HelpDesk.Models.ViewModels
@model IEnumerable<CatUsuarioViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";


}
<div class="row mb-4">
    <div class="col-8 d-flex justify-content-start">
        <i class="ti ti-users" style="font-size:3em"></i>
        <div>
            <h2 class="page-title">Usuarios</h2>
            <div class="page-pretitle">Creación de usuarios, administración, y asignación de roles</div>
        </div>
    </div>
    <div class="col-4 justify-content-end d-flex">
        @{
            if (Html.TieneAcceso(roles: new[] { "Administrador","Administrador Supervisor", "Soporte" }))
            {
                <button onclick="nuevoUsuario()" class="btn btn-primary"><i class="ti ti-circle-plus mr-2"></i>Nuevo usuario</button>
            }
        }  
    </div>
</div>


<div class="col-lg-12">
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs nav-fill" data-bs-toggle="tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a href="#todosUsuarios" class="nav-link active" data-bs-toggle="tab" aria-selected="true" role="tab">Todos los usuarios</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#administrador" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Administrador</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#soporte" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Soporte</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#usuario" class="nav-link" data-bs-toggle="tab" aria-selected="false" tabindex="-1" role="tab">Usuario</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane active show" id="todosUsuarios" role="tabpanel">
                    <div class="block" >
                        <table class="display table-responsive" id="tablaTodosUsuarios" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.NombreCompleto)
                                    </th>

                                    <th>
                                        @Html.DisplayNameFor(model => model.CorreoElectronico)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.RolNombre)
                                    </th>
                                    <th data-priority="1">
                                        @Html.DisplayNameFor(model => model.PlazaNombre)
                                    </th>
                                    <th data-priority="999">
                                        @Html.DisplayNameFor(model => model.AreaNombre)
                                    </th>
                                    <th data-priority="1000">
                                        @Html.DisplayNameFor(model => model.FechaInactivacion)
                                        </th>
                                    <th data-priority="1">
                                            Acciones
                                        </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NombreCompleto)
                                        </td>

                                        <td>
                                            @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.RolNombre)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PlazaNombre)
                                        </td><td>
                                            @Html.DisplayFor(modelItem => item.AreaNombre)
                                        </td>

                                        <td class="fechaInactivacion_@item.Id">
                                            @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                        </td>


                                        <td>
                                            @{
                                                if (Html.TieneAcceso(roles: new[] { "Administrador", "Administrador Supervisor", "Soporte" }))
                                                {
                                                    <button type="button" class="btn btn-primary estadoUsuario_@item.Id" onclick="cambiarEstadoUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva al usuario">
                                                        <i class="ti ti-circle-@(item.Activo? "x" : "check")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite cambiar los permisos del usuario" onclick="mostrarPermisos('@item.Id')"><i class="ti ti-circle-key"></i></button>
                                                    <button type="button" class="btn btn-primary" onclick="editarUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite modificar la información del usuario"><i class="ti ti-edit"></i></button>
                                                }
                                            }
                                            
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="administrador" role="tabpanel">
                        <div class="block">
                        <table class="display table-responsive" id="tablaAdministrador" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.NombreCompleto)
                                    </th>

                                    <th>
                                        @Html.DisplayNameFor(model => model.CorreoElectronico)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.RolNombre)
                                    </th>
                                    <th data-priority="1">
                                        @Html.DisplayNameFor(model => model.PlazaNombre)
                                    </th>
                                    <th data-priority="999">
                                        @Html.DisplayNameFor(model => model.AreaNombre)
                                    </th>
                                    <th data-priority="1000">
                                        @Html.DisplayNameFor(model => model.FechaInactivacion)
                                    </th>
                                    <th data-priority="1">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Administrador" || u.RolNombre == "Administrador Supervisor").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                        <td class="fechaInactivacion_@item.Id">

                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                        <td>
                                            @{
                                                if (Html.TieneAcceso(roles: new[] { "Administrador", "Administrador Supervisor", "Soporte" }))
                                                {
                                                    <button type="button" class="btn btn-primary estadoUsuario_@item.Id" onclick="cambiarEstadoUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva al usuario">
                                                        <i class="ti ti-circle-@(item.Activo? "x" : "check")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite cambiar los permisos del usuario" onclick="mostrarPermisos('@item.Id')"><i class="ti ti-circle-key"></i></button>
                                                    <button type="button" class="btn btn-primary" onclick="editarUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite modificar la información del usuario"><i class="ti ti-edit"></i></button>
                                                }
                                            }
                                        </td>
                                        </tr>
                                    }
                                </tbody>
                           
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane" id="soporte" role="tabpanel">
                    <table class="display table-responsive" id="tablaSoporte" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.NombreCompleto)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CorreoElectronico)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.RolNombre)
                                </th>
                                <th data-priority="1">
                                    @Html.DisplayNameFor(model => model.PlazaNombre)
                                </th>
                                <th data-priority="999">
                                    @Html.DisplayNameFor(model => model.AreaNombre)
                                </th>
                                <th data-priority="1000">
                                    @Html.DisplayNameFor(model => model.FechaInactivacion)
                                </th>
                                <th data-priority="1">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Soporte").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                        <td class="fechaInactivacion_@item.Id">

                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                        <td>
                                        @{
                                            if (Html.TieneAcceso(roles: new[] { "Administrador", "Administrador Supervisor", "Soporte" }))
                                            {
                                                <button type="button" class="btn btn-primary estadoUsuario_@item.Id" onclick="cambiarEstadoUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva al usuario">
                                                    <i class="ti ti-circle-@(item.Activo? "x" : "check")"></i>
                                                </button>
                                                <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite cambiar los permisos del usuario" onclick="mostrarPermisos('@item.Id')"><i class="ti ti-circle-key"></i></button>
                                                <button type="button" class="btn btn-primary" onclick="editarUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite modificar la información del usuario"><i class="ti ti-edit"></i></button>
                                            }
                                        }
                                        </td>
                                        </tr>
                                    }
                                </tbody>
                            
                            </table>
                        </div>
      
                    <div class="tab-pane" id="usuario" role="tabpanel">
                    <div class="col-12">
                    <table class="display table-responsive" id="tablaUsuario" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>
                                    @Html.DisplayNameFor(model => model.NombreCompleto)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CorreoElectronico)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.RolNombre)
                                </th>
                                <th data-priority="2">
                                    @Html.DisplayNameFor(model => model.PlazaNombre)
                                </th>
                                <th data-priority="999">
                                    @Html.DisplayNameFor(model => model.AreaNombre)
                                </th>
                                <th data-priority="1000">
                                    @Html.DisplayNameFor(model => model.FechaInactivacion)
                                </th>
                                <th data-priority="1">
                                    Acciones
                                </th>
                            </tr>
                        </thead>
                                <tbody>
                                    @foreach (var item in Model.Where(u => u.RolNombre == "Usuario").ToList())
                                    {
                                        <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NumeroUsuario)
                                        </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.NombreCompleto)
                                            </td>

                                            <td>
                                                @Html.DisplayFor(modelItem => item.CorreoElectronico)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RolNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.PlazaNombre)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.AreaNombre)
                                            </td>

                                            <td class="fechaInactivacion_@item.Id">
                                                @Html.DisplayFor(modelItem => item.FechaInactivacion)
                                            </td>


                                        <td>
                                            @{
                                                if (Html.TieneAcceso(roles: new[] { "Administrador", "Administrador Supervisor", "Soporte" }))
                                                {
                                                    <button type="button" class="btn btn-primary estadoUsuario_@item.Id" onclick="cambiarEstadoUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Activa o desactiva al usuario">
                                                        <i class="ti ti-circle-@(item.Activo? "x" : "check")"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite cambiar los permisos del usuario" onclick="mostrarPermisos('@item.Id')"><i class="ti ti-circle-key"></i></button>
                                                    <button type="button" class="btn btn-primary" onclick="editarUsuario('@item.Id')" data-bs-toggle="tooltip" data-bs-placement="top" title="Permite modificar la información del usuario"><i class="ti ti-edit"></i></button>
                                                }
                                            }
                                        </td>
                                        </tr>
                                    }
                                </tbody>
                            
                            </table>
                        </div>
                    </div><!--tab pane-->
                </div>
            </div><!--card body-->
    </div><!--card-->
</div>

<script src="~/js/CatalogoUsuarios/index.js"></script>

<script>
    $(document).ready(function() {
    $('#tablaTodosUsuarios').DataTable({
            responsive:true,
            
            language: lenguajeTablaGenerica
        });

        $('#tablaAdministrador').DataTable({
            responsive:true,
            language: lenguajeTablaGenerica
        });
        $('#tablaSoporte').DataTable({
            responsive:true,
            language: lenguajeTablaGenerica
        });
        $('#tablaUsuario').DataTable({
            responsive:true,
            language: lenguajeTablaGenerica
        });
    } );</script>