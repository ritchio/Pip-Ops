@using HelpDesk.Authorization
@using HelpDesk.Models.ViewModels
@model List<TicketsCerradosViewModel>
<div class="row">
    <div class="col-12 d-flex justify-content-start">
        <i class="ti ti-ticket title-icon"></i>
        <div>
            <h2 class="page-title">Mis Tickets Cerrados</h2>
            <div class="page-pretitle">Tickets solucionados en espera de validación</div>
        </div>
    </div>
</div>
<div class="col-12">
    <div class="card">
        <div class="card-header"></div>
        <div class="card-body">
            @if(Html.TieneAcceso(roles: [Roles.Soporte]))
            {
                <table class="display table table-responsive table-striped" id="tablaTicketsCerradosSoporte">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Solicitante</th>
                            <th>Plaza</th>
                            <th>Área</th>
                            <th>Agente asignado</th>
                            <th>Asunto</th>
                            <th>Cuerpo</th>
                            <th>Fecha de Solicitud</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var ticket in Model)
                            {
                                <tr>

                                    <td>@(ticket.IdTicket?.ToString("D3") ?? "")</td>
                                    <td>@ticket.Solicitante</td>
                                    <td>@ticket.Plaza</td>
                                    <td>@ticket.Area</td>
                                    <td>@ticket.NombreAgente</td>
                                    <td>@ticket.Asunto</td>
                                    <td>@ticket.Cuerpo</td>
                                    <td>@ticket.FechaSolicitud</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-primary" onclick="mostrarDetallesTicket(@ticket.IdTicket)"><i class="ti ti-eye"></i></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            }
            else
            {
                <table class="display table table-responsive table-striped" id="tablaTicketsCerradosSoporte">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Agente asignado</th>
                            <th>Asunto</th>
                            <th>Cuerpo</th>
                            <th>Fecha de Solicitud</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var ticket in Model)
                            {
                                <tr>
                                    <td>@(ticket.IdTicket?.ToString("D3") ?? "")</td>
                                    <td>@ticket.NombreAgente</td>
                                    <td>@ticket.Asunto</td>
                                    <td>@ticket.Cuerpo</td>
                                    <td>@ticket.FechaSolicitud</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-primary" onclick="mostrarDetallesTicket(@ticket.IdTicket)"><i class="ti ti-eye"></i></button>
                                        <button class="btn btn-primary" onclick="validarTicket(@ticket.IdTicket)"><i class="ti ti-circle-check"></i></button>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>

                </table>
            }
           

        </div>
        <div class="card-footer"></div>
    </div>
</div>

<script>
    $(function(){
    $("#tablaTicketsCerradosSoporte").DataTable({
        responsive: true,
         columnDefs:[
            {
                responsivePriority:1,
                targets:-1
            },
            {
                visible:false,
                targets:-3
            }
        ],
        language:lenguajeTablaGenerica
    });
    });

</script>