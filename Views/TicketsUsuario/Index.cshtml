@using HelpDesk.Models.ViewModels
@model List<TicketsNuevosViewModel>
<div class="row">
    <div class="col-12 d-flex justify-content-start">
        <i class="ti ti-ticket title-icon"></i>
        <div>
            <h2 class="page-title">Mis Tickets Nuevos</h2>
            <div class="page-pretitle">Tickets en espera de resolucion</div>
        </div>
    </div>
</div>
<div class="col-12">
    <div class="card">
        <div class="card-header"></div>
        <div class="card-body">

            <table class="display table table-responsive table-striped" id="tablaTicketsNuevosSoporte">
                <thead>
                    <tr>
                        <th>Turno</th>
                        <th>#</th>
                        <th>Asunto</th>
                        <th class="d-none">Cuerpo</th>
                        <th>Fecha de Solicitud</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        foreach(var ticket in Model)
                        {
                            <tr>
                                <td>@(ticket.Turno?.ToString("D4") ?? "")</td>
                                <td>@(ticket.IdTicket?.ToString("D3") ?? "")</td>
                                <td>@ticket.Asunto</td>
                                <td class="d-none">@ticket.Cuerpo</td>
                                <td>@ticket.FechaSolicitud</td>
                                <td class="text-center"><button type="button" class="btn btn-primary" onclick="mostrarDetallesTicket(@ticket.IdTicket)"><i class="ti ti-eye"></i></button></td>

                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
        <div class="card-footer"></div>
    </div>
</div>

<script>
    $(function(){
    $("#tablaTicketsNuevosSoporte").DataTable({
        responsive: true,
         columnDefs:[
            {
                responsivePriority:1,
                targets:-1
            }
        ],
        language:lenguajeTablaGenerica
    });
    });

</script>