@using HelpDesk.Models.ViewModels
@model List<TicketsPorAutorizarViewModel>

<table class="display table table-responsive table-striped" id="tablaTicketsPorAutorizarUsuario">
    <thead>
        <tr>
            <th>#</th>
            <th>Asunto</th>
            <th>Cuerpo</th>
            <th>Autorizaciones pendientes</th>
            <th>Fecha de Solicitud</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @{
            foreach (var ticket in Model)
            {
                <tr>
                    <td>@(ticket.IdTicket?.ToString("D3") ?? "")</td>
                    <td>@ticket.Asunto</td>
                    <td>@ticket.Cuerpo</td>
                    <td class="text-center">@ticket.AutorizacionesPendientes.ToString("D2") / @ticket.AutorizacionesTotales?.ToString("D2")</td>
                    <td>@ticket.FechaSolicitud</td>
                    <td class="text-center"><button type="button" class="btn btn-primary" onclick="mostrarDetallesTicket(@ticket.IdTicket)"><i class="ti ti-eye"></i></button></td>
                </tr>
            }
        }
    </tbody>

</table>

<script>
    $(function(){
    $("#tablaTicketsPorAutorizarUsuario").DataTable({
        responsive: true,
         columnDefs:[
            {
                responsivePriority:1,
                targets:-1
            },
            {
                visible:false,
                targets:2
            }
        ],
        language:lenguajeTablaGenerica
    });

    $("#numeroTicketsPorAutorizar").text('@Model.Count()')

    });

</script>