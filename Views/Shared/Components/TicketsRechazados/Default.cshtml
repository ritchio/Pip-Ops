@using HelpDesk.Models.ViewModels
@model List<TicketsRechazadosViewModel>

            <table class="display table table-responsive table-striped" id="tablaTicketsRechazadosSoporte">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Asunto</th>
                        <th>Fecha de Solicitud</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        foreach (var ticket in Model)
                        {
                            <tr>
                                <td>@(ticket.IdTicket?.ToString("D3") ?? "")</td>
                                <td>@ticket.Asunto</td>
                                <td>@ticket.FechaSolicitud</td>
                                <td class="text-center"><button type="button" class="btn btn-primary" onclick="mostrarDetallesTicket(@ticket.IdTicket)"><i class="ti ti-eye"></i></button></td>

                            </tr>
                        }
                    }
                </tbody>

            </table>


<script>
    $(function(){
    $("#tablaTicketsRechazadosSoporte").DataTable({
        responsive: true,
         columnDefs:[
            {
                responsivePriority:1,
                targets:-1
            }
        ],
        language:lenguajeTablaGenerica
    });
    $("#numeroTicketsRechazados").text('@Model.Count()')
    });

</script>