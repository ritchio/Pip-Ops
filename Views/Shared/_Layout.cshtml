<script src="~/js/Shared/axiosRequest.js"></script>
<script src="~/js/Tickets/index.js"></script>
<script src="~/js/inicio.js"></script>

<script>

    @if (TempData["Notificacion"] != null)
    {
            var json = System.Text.Json.JsonSerializer.Serialize(TempData["Notificacion"]);
            <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        mostrarNotificacion(@Html.Raw(json))
                    });
            </text>
    }
</script>
<!-- fin script personalizados-->
</html>
