   <link href="/css/tabler-vendors.min.css?1744111186" rel="stylesheet" integrity="sha384-cFz/XfWTmyCb5jkPFO3b51Vgc16vyrRzL3LLD2Ah7yFnpVjxN6nalaCc02Xg2vh4" />  
   <link href="/css/tabler-marketing.min.css?1744111186" rel="stylesheet" integrity="sha384-/IK/eDAkWg4gzAdp6tVmpjq6GEQGamdwbnfsuK0PNDDQPsD9ytW0gIXSK/dZWgAK" />  
   <link href="/css/tabler-themes.min.css?1744111186" rel="stylesheet" integrity="sha384-Bj8pP2O3iJP6JH/ZdDBnxIH/3XOJF8DSyYUUHs8wTxb0PRUe5DU01llAmog5ybpg" />  
   <!-- END PLUGINS STYLES -->  
   <!-- BEGIN DEMO STYLES -->  
   <!--link href="./preview/css/demo.min.css?1744111186" rel="stylesheet" integrity="sha384-BUDq2P684xwRBf0GDlySvob+KJg4ko8y2K7njgvYBscmEuqoVVqJ75zcTDozwkFA" />  
   <!-- END DEMO STYLES -->  
   <!-- BEGIN CUSTOM FONT -->  
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/&#64;tabler/icons-webfont@latest/tabler-icons.min.css">  
   <link href="https://rsms.me/inter/inter.css" rel="stylesheet">  
    
   <link href="~/css/site.css" rel="stylesheet">  
   <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css">
    <!-- END CUSTOM FONT -->  
   <script src="~/lib/jquery/dist/jquery.min.js"></script>  
   <script src="https://cdn.jsdelivr.net/npm/&#64;popperjs/core@2.9.2/dist/umd/popper.min.js"></script>  
