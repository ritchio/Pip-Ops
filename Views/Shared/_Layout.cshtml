<body>
        <!-- BEGIN GLOBAL THEME SCRIPT -->
    <script src="~/js/tabler-theme.min.js?1744111186" integrity="sha384-xCA/37z74Ws4TlN18VkTDQ/T5bWJpvhV8k5y5Qp8qMKqKMHSHdAOcQ9qGPn0pUJj"></script>
    <!-- END GLOBAL THEME SCRIPT -->
    <div class="page">
      <!--  BEGIN SIDEBAR  -->
        <partial name="_SideBar" />
      <!--  END SIDEBAR  -->
      <!-- BEGIN NAVBAR  -->
        <partial name="_NavBar" />
      <!-- END NAVBAR  -->
        <div class="page-wrapper">

            <!-- BEGIN PAGE BODY -->
            <div class="page-body">
                <div class="container-xl">
                    <div class="row row-deck row-cards">
                        
                        @RenderBody()
                        
                    </div>
                </div>
            </div>
            <!-- END PAGE BODY -->
            <!--  BEGIN FOOTER  -->
            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                            &copy; 2025 - HelpDesk - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </div>
            </footer>
            <!--  END FOOTER  -->
        </div>
            
    <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/Shared/axiosRequest.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    </div>

    <!-- BEGIN PAGE LIBRARIES -->
    <script src="~/lib/apexcharts/dist/apexcharts.min.js?1744111186" defer></script>
    <script src="~/lib/jsvectormap/dist/jsvectormap.min.js?1744111186" defer></script>
    <script src="~/lib/jsvectormap/dist/maps/world.js?1744111186" defer></script>
    <script src="~/lib/jsvectormap/dist/maps/world-merc.js?1744111186" defer></script>
    <!-- END PAGE LIBRARIES -->
    <!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    @* <script src="~/js/tabler.min.js"  integrity="sha384-uSpys8fjyVTPrXxPMi+NhnEMIp1YSGFZSCDrRHjYIUVdInIvlHft8JHLm6Oiw3vA"></script> *@
    <script>

        @if (TempData["Notificacion"] != null)
        {
            var json = System.Text.Json.JsonSerializer.Serialize(TempData["Notificacion"]);
            <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        mostrarNotificacion(@Html.Raw(json))
                    });
            </text>
        }
    </script>
    <!-- END GLOBAL MANDATORY SCRIPTS -->
    <!-- Inicio notificaciones -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast" id="notificacionToast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
            
            <div class="toast-header bg-info" id="notificacionCabecera">                
                <strong class="me-auto text-light" id="notificacionTitulo">Notificación</strong>

                <button type="button" class="ms-2 btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="notificacionMensaje">Mensaje.</div>
        </div>

    </div>
    <!-- final notificaciones -->
    <!-- inicio modal genérico para mostrar vistas parciales--->
    <div class="modal modal-blur fade" id="modalGenerico" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-3 modal-dialog-centered" role="document">
            <div class="modal-content" id="modalGenericoCuerpo">
                
            </div>
        </div>
    </div>
    <!-- fin modal -->
    <!-- inicio pantalla de espera -->
    <div id="cargando" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 modal-blur justify-content-center align-items-center" style="z-index: 1050; display:none;" >
        <div class="text-center position-absolute top-50 start-50 translate-middle">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
            </div>
            <div class="fw-bold text-light fs-4" id="mensajeEspera">Por favor, espere un momento...</div>
        </div>
    </div>
    <!-- fin pantalla de espera -->
   <partial name="_ConfiguracionTema" />
    @* <button type="button" class="btn btn-primary" onclick="crearNotificacion()">asd asd asd asdasd asda sasdasdas dasd asda asd asd aasdnotificar</button> *@
</body>
</html>
