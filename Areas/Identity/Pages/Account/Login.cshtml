@page
@model LoginModel


<div class="page page-center">
    <div class="container container-tight py-4">

        <div class="card card-md">
            <div class="card-body">
                <div class="text-center mb-4">
                    <!-- BEGIN NAVBAR LOGO -->
                    <h1>HelpDesk</h1>
                    <!-- END NAVBAR LOGO -->
                </div>
                <section>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre123@surx.mx" />
                            <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label">Contraseña</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="checkbox mb-3 d-none">
                            <label asp-for="Input.RememberMe" class="form-label">
                                <input class="form-check-input " asp-for="Input.RememberMe" checked="true"/> Recordar mis datos
                            </label>
                        </div>
                        <div>
                            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Acceder</button>
                        </div>
                        <div>
                            <p class="mt-4">
                                ¿Olvidaste tu contraseña? <a asp-controller="Acceso" asp-action="ReiniciarContrasenia">Reiniciar Contraseña</a>
                            </p>
                            
                        </div>
                    </form>
                </section>
            </div>
   
        </div>
    </div>
</div>

        
@await Component.InvokeAsync("MensajeDelDia");    


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}