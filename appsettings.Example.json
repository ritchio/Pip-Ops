{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Database=pipops;User Id=username;Password=yourpassword;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Smtp": {
    "Server": "your.smtp.server",
    "Port": "587",
    "User": "yourusername@example.com",
    "Password": "yourpassword"
  },
  "AppSettings": {
    "PathBase": "",
    "Title": "Pip-Ops"
  },
  "Security": {
    "Totp": {
      "Issuer": "Pip-Ops",
      "Digits": 6,
      "Period": 30
    },
    "Session": {
      "MaxHours": 15
    }
  }
}